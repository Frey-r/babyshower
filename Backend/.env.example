# Copia este archivo a .env y ajusta los valores.

# Contraseña de Postgres (genera una aleatoria, ej: openssl rand -hex 16)
DB_PASSWORD=

# SHA256 de los certificados de cliente Cloudflare permitidos para el admin,
# separados por coma. Se ve al crear cada client certificate en el dashboard.
# Vacío = sin verificación extra de fingerprint (solo regla WAF de Cloudflare).
ADMIN_CERT_FINGERPRINTS=

# Nombre de la red docker externa donde está conectado cloudflared.
# Descúbrelo en la Raspberry con: docker network ls
CLOUDFLARED_NETWORK=cloudflared

# Puerto publicado solo en localhost (para pruebas; cloudflared entra por la red interna)
APP_PORT=8080
