# Copia este archivo a .env y ajusta los valores.

# Contraseña de Postgres (genera una aleatoria, ej: openssl rand -hex 16)
DB_PASSWORD=

# Google OAuth para el login del admin.
# Crea las credenciales en https://console.cloud.google.com/apis/credentials
# Tipo: "Web application", Authorized redirect URIs:
#   - https://abby.ebachmann.dev/api/auth/callback   (producción)
#   - http://localhost:8095/api/auth/callback        (pruebas locales)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=https://abby.ebachmann.dev/api/auth/callback

# Correos Google permitidos para entrar al admin (separados por coma).
ADMIN_EMAILS=

# Nombre de la red docker externa donde está conectado cloudflared.
CLOUDFLARED_NETWORK=cloudflared

# Puerto publicado solo en localhost (para pruebas; cloudflared entra por la red interna)
APP_PORT=8080
